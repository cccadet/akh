{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Akh",
  "version": "0.1.2",
  "identifier": "dev.akh.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "cargo build --release -p akh-cli -p akh-server && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Akh", "width": 1180, "height": 780, "minWidth": 760, "minHeight": 560 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../../target/release/akh.exe": "akh.exe",
      "../../../target/release/akh-server.exe": "akh-server.exe"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
